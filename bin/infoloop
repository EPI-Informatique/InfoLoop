#!/usr/bin/env php
<?php

/**
 * InfoLoop CLI.
 *
 * Usage:
 *   php bin/infoloop migrate                     Apply pending DB migrations
 *   php bin/infoloop seed                        Apply seed data (roles/settings)
 *   php bin/infoloop install                     migrate + seed
 *   php bin/infoloop user:create <user> <email> <password> [role] [location_id]
 *   php bin/infoloop user:reset-password <user>  Interactive password reset
 *   php bin/infoloop user:list
 *   php bin/infoloop ldap:sync                   Sync users from LDAP
 *   php bin/infoloop screen:token <screen_id>   Print the screen URL token
 *   php bin/infoloop log:tail [lines]            Tail the app log
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This script must be run from the CLI.\n");
    exit(1);
}

$config = require dirname(__DIR__) . '/app/bootstrap.php';

use InfoLoop\Core\App;
use InfoLoop\Core\Database;
use InfoLoop\Core\Migrator;
use InfoLoop\Services\AuthService;
use InfoLoop\Services\LdapService;
use PDO;
use Throwable;

$app = new App($config);
$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

/**
 * Writes a line to STDOUT with a timestamp (logging instead of print).
 */
function out(string $message, string $level = 'info'): void
{
    fwrite(STDOUT, sprintf("[%s] [%s] %s\n", date('Y-m-d H:i:s'), $level, $message));
}

/**
 * Removes full-line SQL comments ('-- ...' / '# ...') so a header comment
 * can't swallow the first statement when splitting on ';'.
 */
function infoloop_strip_sql_comments(string $sql): string
{
    return implode("\n", array_filter(
        preg_split('/\r?\n/', $sql) ?: [],
        static fn (string $l): bool => trim($l) !== ''
            && !str_starts_with(trim($l), '--')
            && !str_starts_with(trim($l), '#')
    ));
}

/**
 * Checks runtime prerequisites and reports OK / WARN / FAIL per item.
 *
 * @return int Process exit code (0 = all OK, 1 = at least one FAIL).
 */
function infoloop_doctor(App $app): int
{
    $fail = 0;
    $warn = 0;
    $check = static function (string $label, bool $ok, string $detail = '', bool $isWarn = false) use (&$fail, &$warn): void {
        $status = $ok ? 'OK  ' : ($isWarn ? 'WARN' : 'FAIL');
        if (!$ok && !$isWarn) {
            $fail++;
        } elseif (!$ok) {
            $warn++;
        }
        out(sprintf('[%s] %-38s %s', $status, $label, $detail), $ok ? 'info' : ($isWarn ? 'warning' : 'error'));
    };

    out('== PHP ==');
    $check('PHP version >= 8.4', version_compare(PHP_VERSION, '8.4.0', '>='), PHP_VERSION);
    $requiredExt = ['pdo', 'pdo_mysql', 'mbstring', 'intl', 'fileinfo', 'dom', 'openssl', 'sodium', 'session', 'json', 'filter'];
    $optionalExt = ['ldap' => 'LDAP/AD login', 'gd' => 'image thumbnails'];
    foreach ($requiredExt as $ext) {
        $check("ext-{$ext}", extension_loaded($ext));
    }
    foreach ($optionalExt as $ext => $why) {
        $loaded = extension_loaded($ext);
        $check("ext-{$ext} (optional: {$why})", $loaded, $loaded ? '' : 'not loaded', !$loaded);
    }

    out('== Linux commands ==');
    foreach (['stty' => 'used for hidden password prompts'] as $cmd => $why) {
        $found = trim((string) @shell_exec('command -v ' . escapeshellarg($cmd) . ' 2>/dev/null')) !== '';
        $check("command: {$cmd}", $found, $why, !$found);
    }

    out('== Files & permissions ==');
    $root = dirname(__DIR__);
    $webUser = function_exists('posix_geteuid') ? (string) (posix_getpwuid(posix_geteuid())['name'] ?? 'unknown') : 'unknown';
    $paths = [
        'storage' => 'must be writable by the web/CLI user (logs)',
        'storage/logs' => 'log directory',
        'public/files' => 'uploaded media (sharded)',
        '.env' => 'environment file (if present, must be 0600 and not world-readable)',
        'app/config' => 'must be readable by the web user',
        'public' => 'web root (must be readable/executable by nginx/fpm)',
    ];
    foreach ($paths as $rel => $why) {
        $abs = $root . '/' . $rel;
        if ($rel === '.env' && !is_file($abs)) {
            $check("{$rel} present", false, 'copy .env.example to .env and fill it in', true);
            continue;
        }
        if (!file_exists($abs)) {
            $check("{$rel} exists", false, $why, true);
            continue;
        }
        $check("{$rel} readable", is_readable($abs), $why);
        if (is_dir($abs)) {
            $check("{$rel} writable", is_writable($abs), "running as {$webUser}");
        }
        if ($rel === '.env') {
            $perms = fileperms($abs) & 0777;
            $check('.env permissions 0600', $perms === 0600, sprintf('current: %04o', $perms));
        }
    }

    out('== Configuration ==');
    $db = $app->config('db', $app->config('app.db', []));
    $check('db config present', is_array($db) && $db !== [], is_array($db) ? "host={$db['host']} name={$db['name']} charset={$db['charset']}" : 'missing db section');
    if (is_array($db) && $db !== []) {
        try {
            $pdo = $app->db();
            $check('DB connection', true, (string) $pdo->getAttribute(PDO::ATTR_SERVER_VERSION));
            $charset = $pdo->query('SELECT @@character_set_connection')->fetchColumn();
            $check('connection charset utf8mb4', $charset === 'utf8mb4', "got: {$charset}");
        } catch (Throwable $e) {
            $check('DB connection', false, $e->getMessage());
        }
    }

    out('== Summary ==');
    out($fail === 0 ? "All checks passed ({$warn} warning(s))." : "{$fail} check(s) FAILED, {$warn} warning(s).", $fail === 0 ? 'info' : 'error');
    return $fail === 0 ? 0 : 1;
}

/**
 * Prompts for a hidden password.
 */
function readPassword(string $prompt): string
{
    fwrite(STDOUT, $prompt);
    system('stty -echo');
    $password = (string) fgets(STDIN);
    system('stty echo');
    fwrite(STDOUT, "\n");
    return trim($password);
}

try {
    switch ($command) {
        case 'migrate':
            $ran = (new Migrator($app))->migrate();
            out($ran === [] ? 'Nothing to migrate.' : 'Applied: ' . implode(', ', $ran));
            break;

        case 'seed':
            $sql = (string) file_get_contents(dirname(__DIR__) . '/app/database/seed.sql');
            $sql = infoloop_strip_sql_comments($sql);
            foreach (preg_split('/;\s*(\r?\n|$)/', $sql) ?: [] as $statement) {
                $statement = trim($statement);
                if ($statement !== '') {
                    $app->db()->exec($statement);
                }
            }
            out('Seed data applied.');
            break;

        case 'install':
            $ran = (new Migrator($app))->migrate();
            out('Migrations applied: ' . ($ran === [] ? '(none pending)' : implode(', ', $ran)));
            $seedSql = infoloop_strip_sql_comments((string) file_get_contents(dirname(__DIR__) . '/app/database/seed.sql'));
            foreach (preg_split('/;\s*(\r?\n|$)/', $seedSql) ?: [] as $statement) {
                $statement = trim($statement);
                if ($statement !== '') {
                    $app->db()->exec($statement);
                }
            }
            out('Seed data applied. Then create an admin: php bin/infoloop user:create admin admin@example.com <password> super_admin');
            break;

        case 'user:create':
            [$user, $email, $password] = [$args[0] ?? '', $args[1] ?? '', $args[2] ?? ''];
            $role = $args[3] ?? 'admin';
            $locationId = (int) ($args[4] ?? 0);
            if ($user === '' || $email === '' || $password === '') {
                throw new InvalidArgumentException('Usage: user:create <username> <email> <password> [role] [location_id]');
            }
            if (mb_strlen($password) < 12) {
                throw new InvalidArgumentException('Password must be at least 12 characters.');
            }
            $db = new Database($app->db());
            $roleId = (int) ($db->scalar('SELECT id FROM roles WHERE name = :r', ['r' => $role]) ?? 0);
            if ($roleId === 0) {
                throw new InvalidArgumentException("Unknown role '{$role}'.");
            }
            $db->insert('users', [
                'username' => $user,
                'email' => $email,
                'display_name' => $user,
                'password_hash' => $app->service(AuthService::class)->hashPassword($password),
                'role_id' => $roleId,
                'location_id' => $locationId > 0 ? $locationId : null,
                'source' => 'local',
                'is_active' => 1,
            ]);
            out("User '{$user}' created with role '{$role}'.");
            break;

        case 'user:reset-password':
            $user = $args[0] ?? '';
            if ($user === '') {
                throw new InvalidArgumentException('Usage: user:reset-password <username>');
            }
            $db = new Database($app->db());
            $row = $db->one('SELECT id FROM users WHERE username = :u', ['u' => $user]);
            if (!is_array($row)) {
                throw new InvalidArgumentException("User '{$user}' not found.");
            }
            $password = readPassword("New password for {$user} (min 12 chars): ");
            if (mb_strlen($password) < 12) {
                throw new InvalidArgumentException('Password must be at least 12 characters.');
            }
            $confirm = readPassword('Confirm new password: ');
            if ($password !== $confirm) {
                throw new InvalidArgumentException('Passwords do not match.');
            }
            $db->update('users', [
                'password_hash' => $app->service(AuthService::class)->hashPassword($password),
                'failed_attempts' => 0,
                'locked_until' => null,
            ], 'id = :id', ['id' => (int) $row['id']]);
            out("Password reset for '{$user}'.");
            break;

        case 'user:list':
            $db = new Database($app->db());
            foreach ($db->all('SELECT u.username, u.email, r.label AS role, u.source, u.is_active, u.mfa_enabled, u.last_login_at FROM users u JOIN roles r ON r.id = u.role_id ORDER BY u.username') as $u) {
                out(sprintf('%-20s %-30s %-18s %-6s active=%d mfa=%d last=%s', $u['username'], $u['email'], $u['role'], $u['source'], (int) $u['is_active'], (int) $u['mfa_enabled'], $u['last_login_at'] ?? '-'));
            }
            break;

        case 'ldap:sync':
            $result = $app->service(LdapService::class)->syncUsers();
            out("LDAP sync: {$result['created']} created, {$result['updated']} updated.");
            break;

        case 'screen:token':
            $screenId = (int) ($args[0] ?? 0);
            $db = new Database($app->db());
            $row = $db->one('SELECT token, name FROM screens WHERE id = :id', ['id' => $screenId]);
            if (!is_array($row)) {
                throw new InvalidArgumentException("Screen {$screenId} not found.");
            }
            out("Screen '{$row['name']}' URL: /?screen={$row['token']}");
            break;

        case 'log:tail':
            $lines = (int) ($args[0] ?? 50);
            $logFile = (string) $app->config('log.dir') . '/app-' . date('Y-m-d') . '.log';
            if (!is_file($logFile)) {
                out("No log file for today ({$logFile}).");
                break;
            }
            $all = file($logFile) ?: [];
            foreach (array_slice($all, -$lines) as $line) {
                fwrite(STDOUT, $line);
            }
            break;

        case 'doctor':
            exit(infoloop_doctor($app));
            break;

        case 'help':
        default:
            out(<<<'HELP'
InfoLoop CLI commands:
  migrate                          Apply pending database migrations
  seed                             Apply seed data (roles, default location, settings)
  install                          migrate + seed
  doctor                           Check prerequisites: PHP version/extensions, tools,
                                   directory permissions, .env, DB connectivity
  user:create <user> <email> <pw> [role] [location_id]
  user:reset-password <user>       Reset an admin password interactively
  user:list                        List admin users
  ldap:sync                        Synchronise users from LDAP/AD
  screen:token <screen_id>         Show the kiosk URL for a screen
  log:tail [lines]                 Tail today's application log
HELP
            );
            break;
    }
} catch (Throwable $e) {
    fwrite(STDERR, sprintf("[%s] [error] %s\n", date('Y-m-d H:i:s'), $e->getMessage()));
    exit(1);
}
