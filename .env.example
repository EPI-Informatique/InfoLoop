# InfoLoop environment configuration.
# Copy this file to ".env" and adjust the values for your server.

# Application
APP_NAME=InfoLoop
APP_ENV=production            # production | development
APP_URL=http://localhost:8080  # public base URL (used for absolute links)
APP_TIMEZONE=Europe/Paris
APP_DEBUG=false

# Session / security
SESSION_NAME=infoloopsess
SESSION_LIFETIME=7200         # seconds
CSRF_TOKEN_NAME=_csrf

# Database (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infoloop
DB_USER=infoloop
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Logging
LOG_LEVEL=info                # debug | info | warning | error
LOG_DIR=storage/logs

# Upload limits
MAX_UPLOAD_MB=200

# LDAP / Active Directory (optional - can also be set from the admin panel)
LDAP_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_FILTER=(member={dn})
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAYNAME=displayName
LDAP_DEFAULT_ROLE=viewer
